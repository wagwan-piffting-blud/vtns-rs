{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VTNS",
  "version": "1.0.0",
  "identifier": "io.github.wagwan-piffting-blud.vtns",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; media-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Read text aloud with VoiceText voices",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "303D624AEF460613E64D9F807DBB15B7939369B9",
      "hardenedRuntime": true
    }
  }
}
